{
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"printWidth": 100,
	"semi": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"overrides": [
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		},
		{
			"files": ["*.json", "*.jsonc", "*.code-snippets"],
			"options": {
				"tabWidth": 2
			}
		}
	]
}
