{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://twig-toolbox.dev/schemas/dialect-pack.schema.json",
	"title": "Twig Toolbox dialect pack",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "name", "displayName", "version", "sources", "detect", "entries"],
	"properties": {
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"displayName": {
			"type": "string",
			"minLength": 1
		},
		"version": {
			"type": "string",
			"minLength": 1
		},
		"sources": {
			"description": "Pinned checkouts the pack was generated from. Packs spanning several major versions of their subject may name extra refs (e.g. twigPrevious).",
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/sourceRef"
			},
			"required": ["twig", "docs"],
			"properties": {
				"twig": {
					"$ref": "#/$defs/sourceRef"
				},
				"docs": {
					"$ref": "#/$defs/sourceRef"
				}
			}
		},
		"detect": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "always"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "composerPackages"],
					"properties": {
						"kind": {
							"const": "composer"
						},
						"composerPackages": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string",
								"minLength": 1
							}
						},
						"versionFrom": {
							"description": "Package whose installed version gates this pack's sinceVersion/removedVersion.",
							"type": "string",
							"minLength": 1
						}
					}
				}
			]
		},
		"entries": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tags", "filters", "functions", "tests", "globals"],
			"properties": {
				"tags": {
					"$ref": "#/$defs/entryArray"
				},
				"filters": {
					"$ref": "#/$defs/entryArray"
				},
				"functions": {
					"$ref": "#/$defs/entryArray"
				},
				"tests": {
					"$ref": "#/$defs/entryArray"
				},
				"globals": {
					"$ref": "#/$defs/entryArray"
				}
			}
		},
		"objects": {
			"description": "Dotted API surfaces: a global's object type, and the types its members yield.",
			"type": "array",
			"items": {
				"$ref": "#/$defs/object"
			}
		}
	},
	"$defs": {
		"sourceRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "ref"],
			"properties": {
				"repository": {
					"type": "string",
					"minLength": 1
				},
				"ref": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				},
				"path": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"entryArray": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/entry"
			}
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"signature",
				"parameters",
				"description",
				"docsUrl",
				"completionSnippet"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"aliases": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"objectType": {
					"description": "For globals: the objects[] entry describing what dotting into this yields.",
					"type": "string",
					"minLength": 1
				},
				"signature": {
					"type": "string",
					"minLength": 1
				},
				"parameters": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/parameter"
					}
				},
				"description": {
					"type": "string",
					"minLength": 8
				},
				"docsUrl": {
					"type": "string",
					"format": "uri"
				},
				"sinceVersion": {
					"type": "string",
					"minLength": 1
				},
				"removedVersion": {
					"description": "First version without this item — exclusive, so \"5.0.0\" means gone in 5.",
					"type": "string",
					"minLength": 1
				},
				"deprecated": {
					"$ref": "#/$defs/deprecation"
				},
				"completionSnippet": {
					"type": "string",
					"minLength": 1
				},
				"source": {
					"$ref": "#/$defs/source"
				}
			}
		},
		"deprecation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sinceVersion"],
			"properties": {
				"sinceVersion": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"extension": {
					"type": "string",
					"minLength": 1
				},
				"phpClass": {
					"type": "string",
					"minLength": 1
				},
				"docsPath": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"object": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "description", "docsUrl", "members"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"extends": {
					"description": "Object whose members this one also has.",
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"minLength": 8
				},
				"docsUrl": {
					"type": "string",
					"format": "uri"
				},
				"members": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/member"
					}
				}
			}
		},
		"member": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"kind",
				"signature",
				"parameters",
				"description",
				"docsUrl",
				"completionSnippet"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"kind": {
					"enum": ["property", "method"]
				},
				"type": {
					"description": "Object this member evaluates to. Absent when the chain ends here.",
					"type": "string",
					"minLength": 1
				},
				"signature": {
					"type": "string",
					"minLength": 1
				},
				"parameters": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/parameter"
					}
				},
				"description": {
					"type": "string",
					"minLength": 8
				},
				"docsUrl": {
					"type": "string",
					"format": "uri"
				},
				"sinceVersion": {
					"type": "string",
					"minLength": 1
				},
				"removedVersion": {
					"type": "string",
					"minLength": 1
				},
				"deprecated": {
					"$ref": "#/$defs/deprecation"
				},
				"completionSnippet": {
					"type": "string",
					"minLength": 1
				},
				"source": {
					"$ref": "#/$defs/source"
				}
			}
		},
		"parameter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "optional"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"optional": {
					"type": "boolean"
				},
				"default": {
					"type": "string"
				},
				"description": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
