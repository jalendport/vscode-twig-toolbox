{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://twig-toolbox.dev/schemas/dialect-pack.schema.json",
	"title": "Twig Toolbox dialect pack",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "name", "displayName", "version", "sources", "detect", "entries"],
	"properties": {
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"displayName": {
			"type": "string",
			"minLength": 1
		},
		"version": {
			"type": "string",
			"minLength": 1
		},
		"sources": {
			"type": "object",
			"additionalProperties": false,
			"required": ["twig", "docs"],
			"properties": {
				"twig": {
					"$ref": "#/$defs/sourceRef"
				},
				"docs": {
					"$ref": "#/$defs/sourceRef"
				}
			}
		},
		"detect": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "always"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "composerPackages"],
					"properties": {
						"kind": {
							"const": "composer"
						},
						"composerPackages": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				}
			]
		},
		"entries": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tags", "filters", "functions", "tests", "globals"],
			"properties": {
				"tags": {
					"$ref": "#/$defs/entryArray"
				},
				"filters": {
					"$ref": "#/$defs/entryArray"
				},
				"functions": {
					"$ref": "#/$defs/entryArray"
				},
				"tests": {
					"$ref": "#/$defs/entryArray"
				},
				"globals": {
					"$ref": "#/$defs/entryArray"
				}
			}
		}
	},
	"$defs": {
		"sourceRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "ref"],
			"properties": {
				"repository": {
					"type": "string",
					"minLength": 1
				},
				"ref": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				},
				"path": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"entryArray": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/entry"
			}
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"signature",
				"parameters",
				"description",
				"docsUrl",
				"completionSnippet"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"aliases": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"signature": {
					"type": "string",
					"minLength": 1
				},
				"parameters": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/parameter"
					}
				},
				"description": {
					"type": "string",
					"minLength": 8
				},
				"docsUrl": {
					"type": "string",
					"format": "uri"
				},
				"sinceVersion": {
					"type": "string",
					"minLength": 1
				},
				"deprecated": {
					"type": "object",
					"additionalProperties": false,
					"required": ["sinceVersion"],
					"properties": {
						"sinceVersion": {
							"type": "string",
							"minLength": 1
						},
						"message": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"completionSnippet": {
					"type": "string",
					"minLength": 1
				},
				"source": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"extension": {
							"type": "string",
							"minLength": 1
						},
						"phpClass": {
							"type": "string",
							"minLength": 1
						},
						"docsPath": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			}
		},
		"parameter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "optional"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"optional": {
					"type": "boolean"
				},
				"default": {
					"type": "string"
				},
				"description": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
