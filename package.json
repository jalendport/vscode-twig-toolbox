{
	"name": "twig-toolbox-monorepo",
	"private": true,
	"version": "1.0.0",
	"description": "Monorepo root for the Twig Toolbox VS Code extension",
	"engines": {
		"node": ">=20"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run typecheck && node scripts/build.mjs",
		"build:production": "npm run typecheck && node scripts/build.mjs --production",
		"watch": "node scripts/build.mjs --watch",
		"generate:core": "tsx scripts/generate-core.ts",
		"generate:craft": "tsx scripts/generate-craft.ts",
		"typecheck": "tsc --noEmit",
		"bench": "node --expose-gc --import tsx tests/perf/bench.ts",
		"test": "vitest run && npm run test:grammar",
		"test:grammar": "node scripts/grammar-test.mjs",
		"test:grammar:update": "node scripts/grammar-test.mjs --update",
		"test:electron": "npm run build && node tests/electron/run.mjs",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"package": "npm run build:production && node scripts/package.mjs",
		"clean": "node scripts/clean.mjs"
	},
	"devDependencies": {
		"@shikijs/langs": "^4.3.1",
		"@types/node": "^22.10.2",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.9.2",
		"ajv": "^8.20.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.5",
		"ovsx": "1.0.2",
		"prettier": "^3.9.5",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vitest": "^4.1.10",
		"vscode-tmgrammar-test": "^0.1.3"
	}
}
